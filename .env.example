OPENAI_API_KEY=your-openai-api-key-here
# Нужен положительный баланс на https://platform.openai.com/settings/organization/billing
OPENAI_MODEL=gpt-4o-mini
TMDB_API_KEY=your-tmdb-api-key-here
# Рейтинги IMDb и Кинопоиска берутся с HDRezka (без ключей)
HDREZKA_BASE=https://hdrezka.name
# Дополнительные зеркала HDRezka (через запятую, добавляются к базовому списку)
# HDREZKA_MIRRORS=hdrezka.xyz,rezka.film
# Опциональный JSON со списком зеркал (обновляется раз в сутки)
# HDREZKA_MIRRORS_URL=https://example.com/hdrezka-mirrors.json

# ── YouTube Data API (iframe-поиск плеера) ───────────────────────
YOUTUBE_API_KEY=your-youtube-data-api-key-here

# ── Торренты ───────────────────────────────────────────────────────
# Основной источник раздач — Rutor (открытый, без регистрации):
RUTOR_BASE=https://rutor.info
# Необязательный запасной источник Rutracker (нужны куки авторизации):
# RUTRACKER_BASE=https://rutracker.org
# RUTRACKER_COOKIE=bb_session=...; bb_data=...
# Таймаут запросов к трекерам (мс):
# TORRENT_TIMEOUT_MS=6000
# Встроенный WebTorrent-плеер на странице фильма (false — отключить):
WEBTORRENT_ENABLED=true
# Нативный HDRezka-плеер (false — только iframe-источники: YouTube/Rutube/VK/Dailymotion):
# HDREZKA_PLAYER_ENABLED=false
# Необязательный запасной источник, если HDRezka недоступна:
# OMDB_API_KEY=your-omdb-api-key-here
# KINOPOISK_API_KEY=your-kinopoisk-api-key-here

# ── Локальный recommender engine ───────────────────────────────────
# local_first — рекомендации собирает быстрый локальный алгоритм из
#   реальных TMDB-кандидатов (по умолчанию). ai_first — старое поведение
#   (OpenAI генерирует фильмы), для временного отката.
RECOMMENDER_MODE=local_first
# OpenAI опционально переранжирует top-кандидатов (не придумывает новые фильмы):
OPENAI_RECOMMENDATION_RERANK=false
# OpenAI опционально переписывает reason/whyDetailed для уже выбранных фильмов:
OPENAI_RECOMMENDATION_EXPLANATIONS=false
# Подробные логи движка (сколько кандидатов, исключений, время, источник):
RECOMMENDER_DEBUG=false
# TTL кеша карты жанров TMDB (часы):
RECOMMENDER_CATALOG_CACHE_TTL_HOURS=24

# ── AI governance: кэш, cooldown и rate limit ─────────────────────
# TTL кеша рекомендаций в памяти (мс, по умолчанию 3 часа):
# RECOMMENDATION_CACHE_TTL_MS=10800000
# AI_CACHE_TTL_RECOMMENDATIONS_MS=10800000
# AI_CACHE_TTL_EXPLANATIONS_MS=604800000
# AI_CACHE_TTL_PREMIERES_MS=64800000
# AI_CACHE_TTL_WATCH_NOW_MS=7200000
# AI_CACHE_TTL_TASTE_MS=86400000
# Cooldown между повторными AI-запросами (мс):
# AI_COOLDOWN_RECOMMENDATIONS_MS=60000
# AI_COOLDOWN_EXPLANATIONS_MS=300000
# Лимиты AI-запросов в час (гость / пользователь):
# AI_RATE_GUEST_RECOMMENDATIONS_HOUR=8
# AI_RATE_USER_RECOMMENDATIONS_HOUR=40
# Логи: data/ai_usage_log.jsonl, кеш ответов: data/ai_response_cache.json
